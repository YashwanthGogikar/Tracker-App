{
  "name": "bodybuilding-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "import:workbook": "python3 scripts/import_workbook.py --strict",
    "test:import": "python3 -m unittest discover -s scripts/tests -v",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:all": "npm run test:import && npm run test"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.1.0",
    "idb": "8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
